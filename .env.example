# Repository root — copy to `.env` (gitignored).
# Used by `bom_supplier_connector.env.load_connector_env()` when this file exists.

# CLōD (OpenAI-compatible API)
CLOD_API_KEY=
# Optional; defaults to https://api.clod.io/v1 if unset
CLOD_API_ENDPOINT=

# DigiKey OAuth / API
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# DIGIKEY_CLIENT_SANDBOX=false

# Optional: load a specific env file instead of this path
# BOM_ENV_FILE=
