# Firebase client-side config
# Get these values from Firebase Console → Project Settings → Your apps → Web app
# https://console.firebase.google.com/project/boma--ai/settings/general
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=boma--ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=boma--ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=boma--ai.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Backend API URL (defaults to local FastAPI server)
NEXT_PUBLIC_API_URL=http://localhost:8000
