# Connector / agent keys (CLōD, DigiKey, etc.) belong in the repo-root `.env`; see `../.env.example`.

# Path to Firebase service account JSON (defaults to ./service-account.json)
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Allscale credentials (existing)
ALLSCALE_API_KEY=
ALLSCALE_API_SECRET=
